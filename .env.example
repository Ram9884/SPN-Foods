# SPN Health Mix Environment Variables

# Neon PostgreSQL connection string (Pooling / Serverless)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon PostgreSQL connection string for Vitest test suite (e.g. test branch or isolated database)
TEST_DATABASE_URL=

# Clerk Authentication (Production / Dev keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 / Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public base URL for R2 images (e.g. https://your-bucket.r2.dev or https://cdn.yourdomain.com)
# Used by the storefront to construct image URLs from R2 object keys.
R2_PUBLIC_BASE_URL=

# Public site URL used for canonical URLs and Open Graph metadata
NEXT_PUBLIC_SITE_URL=

# Shipping / Courier Integration (Shiprocket / Aggregator)
SHIPPING_PROVIDER=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_BASE_URL=
SHIPPING_ORIGIN_PINCODE=

# Transactional Emails (Gmail SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=spnhealthmix@gmail.com
# NOTE: SMTP_PASSWORD must be a Google Account "App Password", not the account password.
SMTP_PASSWORD=
EMAIL_FROM=spnhealthmix@gmail.com
EMAIL_REPLY_TO=spnhealthmix@gmail.com
# Optional: HTTP mail gateway / relay bridge URL for serverless edge workers
# SMTP_RELAY_URL=

